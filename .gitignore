# Raw / reference data — large, re-downloadable, provenance tracked in SOURCES.md
# (see README: only processed, analysis-ready subsets are small enough to commit)
data/raw/*
!data/raw/SOURCES.md
data/reference/*
!data/reference/.gitkeep

# Common large bioinformatics file types, wherever they land
*.bam
*.bai
*.cram
*.vcf
*.vcf.gz
*.vcf.gz.tbi
*.bcf
*.bed.gz
*.zip
*.tar.gz

# Keep empty result/data dirs tracked via .gitkeep, but ignore stray junk
*.log
