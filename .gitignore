# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Claude Code local settings
.claude/

# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.eggs/
.ipynb_checkpoints/
.venv/
venv/
env/
.python-version

# R
.Rhistory
.RData
.Ruserdata
.Rproj.user/
renv/library/
renv/staging/
renv/python/
renv/local/
